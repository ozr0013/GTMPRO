# ── Providers — both required for live mode (cross-family judging) ──────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Model ids (override if your account differs; `npm run smoke` validates) ─
MODEL_ACTOR=claude-sonnet-4-5          # Strategist / Copywriter / Coach (Anthropic)
MODEL_JUDGE=gpt-5                      # Critic / Analyst (OpenAI)
MODEL_CHEAP=gpt-5-mini                 # persona voices / Community (OpenAI)
MODEL_IMAGE=gpt-image-1                # hero posts only

# mock = full loop offline, zero API calls (default for dev/tests). live = real calls.
MODEL_MODE=mock
DB_PATH=./flywheel.db

# ── Local models (free, no API keys) — see docs/LOCAL_MODELS.md ─────────────
# MODEL_PROVIDER=local routes every role to an Ollama server instead of cloud APIs.
# Cross-family principle preserved: Qwen acts, Gemma judges.
#MODEL_PROVIDER=local
#LOCAL_BASE_URL=http://localhost:11434/v1
# 32 GB machines:               16 GB machines (defaults):   12 GB machines:
#MODEL_ACTOR_LOCAL=qwen3:14b    #MODEL_ACTOR_LOCAL=qwen3:8b  #MODEL_ACTOR_LOCAL=qwen3:4b
#MODEL_JUDGE_LOCAL=gemma3:12b   #MODEL_JUDGE_LOCAL=gemma3:4b #MODEL_JUDGE_LOCAL=llama3.2:3b
#MODEL_CHEAP_LOCAL=qwen3:4b     # (cheap defaults to judge model to save RAM)
