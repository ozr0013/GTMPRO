# mock = full loop offline, zero API calls (default for dev/tests). live = real model calls.
MODEL_MODE=mock
DB_PATH=./flywheel.db

# ── Live mode runs on LOCAL models by default — free, zero API keys ─────────
# Requires an Ollama server (`OLLAMA_KEEP_ALIVE=45m ollama serve`), models pulled
# per your RAM tier, then `npm run smoke`. Runbook: docs/LOCAL_MODELS.md.
# Cross-family judging preserved: Qwen3 acts, Gemma 3 judges.
#MODEL_PROVIDER=local                   # the default — set only to override
#LOCAL_BASE_URL=http://localhost:11434/v1
# 32 GB machines:               16 GB machines (defaults):   12 GB machines:
#MODEL_ACTOR_LOCAL=qwen3:14b    #MODEL_ACTOR_LOCAL=qwen3:8b  #MODEL_ACTOR_LOCAL=qwen3:4b
#MODEL_JUDGE_LOCAL=gemma3:12b   #MODEL_JUDGE_LOCAL=gemma3:4b #MODEL_JUDGE_LOCAL=llama3.2:3b
#MODEL_CHEAP_LOCAL=qwen3:4b     # (cheap defaults to judge model to save RAM)

# ── Hero images (optional) — see docs/LOCAL_IMAGES.md ───────────────────────
# svg (default) needs nothing and works offline. Anything that fails falls back
# to it, so a post is never left without art.
#
# Local generation, identical on Windows/NVIDIA and Apple Silicon:
#   pip install -r requirements-images.txt && npm run images:server
#IMAGE_PROVIDER=a1111               # svg | a1111 | comfy | openai
#IMAGE_BASE_URL=http://127.0.0.1:7860
# Defaults below suit the bundled SD-Turbo server. For a full SDXL checkpoint via
# real A1111, use 1024/1024, 28 steps, CFG 6.
#IMAGE_STEPS=4
#IMAGE_WIDTH=512
#IMAGE_HEIGHT=512
#IMAGE_CFG=2
#IMAGE_MODEL=                       # ComfyUI: exact checkpoint filename
#IMAGE_TIMEOUT_MS=180000            # a cold model load is slow
#IMAGE_SERVER_MODEL=stabilityai/sd-turbo   # bundled server only

# ── Slack (optional) — route approvals and updates to a human ────────────────
# Unset = no notifications, zero network calls. Verify with `npm run slack:test`.
# DM a person (bot scopes: chat:write, users:read, users:read.email):
#SLACK_BOT_TOKEN=xoxb-...
#SLACK_DM_TARGET=@yourhandle        # @handle, email, or Uxxxxxxx
# ...or post to one channel with no OAuth setup:
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Which events buzz your phone (default: all five)
#SLACK_NOTIFY=approval,published,learned,blocked,meeting
# Used for the "Review it" button's link
#APP_BASE_URL=http://localhost:3000

# ── Optional cloud fallback (UNTESTED — this project never ran on cloud keys) ─
# Opt in with MODEL_PROVIDER=cloud plus both keys. Kept for portability only.
#MODEL_PROVIDER=cloud
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#MODEL_ACTOR=claude-sonnet-4-5          # Strategist / Copywriter / Coach (Anthropic)
#MODEL_JUDGE=gpt-5                      # Critic / Analyst (OpenAI)
#MODEL_CHEAP=gpt-5-mini                 # persona voices / Community (OpenAI)
#MODEL_IMAGE=gpt-image-1                # hero posts only (cloud-only feature)
