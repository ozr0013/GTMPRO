# mock = full loop offline, zero API calls (default for dev/tests). live = real model calls.
MODEL_MODE=mock
DB_PATH=./flywheel.db

# ── Live mode runs on LOCAL models by default — free, zero API keys ─────────
# Requires an Ollama server (`OLLAMA_KEEP_ALIVE=45m ollama serve`), models pulled
# per your RAM tier, then `npm run smoke`. Runbook: docs/LOCAL_MODELS.md.
# Cross-family judging preserved: Qwen3 acts, Gemma 3 judges.
#MODEL_PROVIDER=local                   # the default — set only to override
#LOCAL_BASE_URL=http://localhost:11434/v1
# 32 GB machines:               16 GB machines (defaults):   12 GB machines:
#MODEL_ACTOR_LOCAL=qwen3:14b    #MODEL_ACTOR_LOCAL=qwen3:8b  #MODEL_ACTOR_LOCAL=qwen3:4b
#MODEL_JUDGE_LOCAL=gemma3:12b   #MODEL_JUDGE_LOCAL=gemma3:4b #MODEL_JUDGE_LOCAL=llama3.2:3b
#MODEL_CHEAP_LOCAL=qwen3:4b     # (cheap defaults to judge model to save RAM)

# ── Optional cloud fallback (UNTESTED — this project never ran on cloud keys) ─
# Opt in with MODEL_PROVIDER=cloud plus both keys. Kept for portability only.
#MODEL_PROVIDER=cloud
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#MODEL_ACTOR=claude-sonnet-4-5          # Strategist / Copywriter / Coach (Anthropic)
#MODEL_JUDGE=gpt-5                      # Critic / Analyst (OpenAI)
#MODEL_CHEAP=gpt-5-mini                 # persona voices / Community (OpenAI)
#MODEL_IMAGE=gpt-image-1                # hero posts only (cloud-only feature)
